{
    "version": 2,
    "builds": [
        {
            "src": "src/server.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/src/server.ts"
        }
    ],
    "crons": [
        {
            "path": "/products/sync",
            "schedule": "37 21 * * *"
        }
    ]
}